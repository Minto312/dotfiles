zsh/.zcompdump
zsh/env.zsh
zsh/env.zsh.backup

.config/wezterm/env.lua
*.lua:Zone.Identifier

.config/nvim/lazy-lock.json
.config/nvim/lazyvim.json
.config/configstore
.config/gcloud

.config/gh/hosts.yml
.config/gogcli/
.config/go/telemetry/
.config/nextjs-nodejs/
.config/uv/
.config/zellij/config.kdl.bak

# --- secrets / credentials (このリポジトリは PUBLIC。絶対にコミットしない) ---
.config/Bitwarden CLI/
.config/gws/
.config/mf/
.config/rclone/
.config/tigervnc/
.config/dns-dangling-monitor/env
.config/discord-notify/
.config/resource-audit/
.config/tldv-ingest/
.config/systemd/user/openclaw-gateway.service
.config/cra_anthropic_key

# --- security tooling configs (API キー等が混入しうるため管理外) ---
.config/nuclei/
.config/subfinder/
.config/uncover/

# --- application state / caches (dotfiles ではないランタイム状態) ---
.config/.wrangler/
.config/draw.io/
.config/google-chrome/
.config/google-chrome-for-testing/
.config/projects-cockpit/
.config/libreoffice/
.config/browseruse/
.config/NuGet/
.config/tailscale/
.config/inkscape/
# herdr: config.toml のみ管理し、ログ・ソケット・セッション状態は持たない
.config/herdr/*.log
.config/herdr/*.sock
.config/herdr/session.json
.config/herdr/session-history.json
.config/herdr/release-notes.json

# --- herdr が ~/.agents 以下に自前でインストールするスキル (dotfiles 側では dangling link になる) ---
.claude/skills/herdr

# --- systemd の enable 状態 (symlink)。unit 本体のみ管理する ---
.config/systemd/user/*.target.wants/

# --- プロジェクト側で管理する unit (マシン固有の絶対パスを含むため dotfiles では持たない) ---
# feedscope: https://github.com/Minto312/feedscope の deploy/ が正。
#   再作成: cp deploy/feedscope-*.{service,timer} ~/.config/systemd/user/ && systemctl --user daemon-reload
.config/systemd/user/feedscope-*.service
.config/systemd/user/feedscope-*.timer
# observability: ~/workspace/observability の deploy/ が正。
#   再作成: ~/workspace/observability/deploy/install.sh
.config/systemd/user/observability.service
# agent-web: machine/dev/agent-web の deploy/ が正 (絶対パスを埋め込む)。
.config/systemd/user/agent-web.service
# homepage: ~/workspace/homepage の deploy/ が正。
.config/systemd/user/homepage.service
# regista-weekly-report: ~/workspace/regista 側が正。
.config/systemd/user/regista-weekly-report.service
.config/systemd/user/regista-weekly-report.timer

# --- editor swap files ---
*.swp

# --- Claude Code が切る作業用 worktree (中身は各ブランチのチェックアウト) ---
.claude/worktrees/
