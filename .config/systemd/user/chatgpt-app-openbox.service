[Unit]
# 仮想画面 :90 のウィンドウマネージャ。
# 無くてもアプリは表示されるが、画面を見て操作するとき (サインイン、ダイアログ) に
# ウィンドウの移動・大きさの変更・フォーカスの切り替えができるように動かしておく。
#
# この unit は有効にしない。chatgpt-app.service の Wants= で一緒に起動する。
Description=ChatGPT デスクトップアプリ用のウィンドウマネージャ (openbox, :90)
Documentation=file:///home/karinto/workspace/machine/services/chatgpt-app.md
Requires=chatgpt-app-xvfb.service
After=chatgpt-app-xvfb.service

[Service]
Type=simple
Environment=DISPLAY=:90
ExecStart=/usr/bin/openbox
# Xvfb が落ちると openbox も終わる。Xvfb が戻った後に起動し直す
Restart=always
RestartSec=5
