# tldv-ingest の設定。実物は ~/.config/tldv-ingest/env に 600 で置く。
# ⚠ このリポジトリは PUBLIC。実ファイルは .gitignore 済みなのでコミットされない。
#
#   mkdir -p ~/.config/tldv-ingest && chmod 700 ~/.config/tldv-ingest
#   cp ~/dotfiles/scripts/tldv-ingest/env.example ~/.config/tldv-ingest/env
#   chmod 600 ~/.config/tldv-ingest/env   # 値を埋める

# tl;dv の API キー。https://tldv.io/app/settings/personal-settings/api-keys
# ⚠ API は Pro / Business プラン限定。Free だと 401 になる。
TLDV_API_KEY=

# Drive の受け皿フォルダ。ここに置いた音声/動画が取り込み対象になる。
# 取り込み済みは done/、弾かれたものは failed/ へ移動する。
TLDV_INBOX_FOLDER_ID=
TLDV_DONE_FOLDER_ID=
TLDV_FAILED_FOLDER_ID=

# --- 任意 ---
# 1 回の実行で投入する上限
#TLDV_MAX_PER_RUN=3
# import が通らなかったときの再試行上限。超えたら failed/ へ
#TLDV_MAX_ATTEMPTS=3
# アップロード途中のファイルを掴まないための猶予 (modifiedTime からの秒数)
#TLDV_GRACE_SECONDS=90
# 取り込み完了を待つ上限。超えたら公開を剥がして failed/ へ (秒)
#TLDV_IMPORT_TIMEOUT=3600
# 取り込む会議に参加者として付けるメールアドレス (カンマ区切り)
#TLDV_PARTICIPANTS=
# true にすると import を dryRun で投げる。ファイルは inbox に残る
#TLDV_DRY_RUN=false
# gws が PATH に無い環境用 (systemd から nvm の node を見つけられないとき)
#GWS_BIN=/home/karinto/.nvm/versions/node/v24.18.0/bin/gws
