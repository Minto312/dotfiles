#!/usr/bin/env bash
# lenovo-chrome-shim — Playwright MCP --extension の「ブラウザ起動」を lenovo の Chrome に振り替える
#
# playwright-mcp-browser が --executable-path にこれを渡す。Playwright MCP は拡張機能モードのとき、
# 自分の中に中継 (ws://localhost:<port>) を立てて、ブラウザの実行ファイルを
#   <exe> [--profile-directory=X] [--open-in-background] <connect URL>
# の形で detached・stdio 無視で起動する。ここではその代わりに:
#   1. 中継ポートを ssh -R で lenovo の localhost に通す (拡張機能が ws://localhost:<port> に来る)
#   2. connect URL を lenovo の Chrome (Session 1) で開く。既定では新しいウィンドウ
#      (エージェントのタブグループがそのウィンドウにまとまる。グループを後から別ウィンドウへ
#       移すと接続が切れるので、最初から専用ウィンドウで始める)
#   3. 呼び出し元の MCP が終わったらトンネルを畳む
#
# あわせて connect URL の client 名を、どのセッションか分かる名前に差し替える。拡張機能は
# タブグループに「Playwright · <client 名>」と名前を付けるが、Playwright MCP が入れる client 名は
# MCP クライアントの名前 (Claude Code ならどのセッションも claude-code) なので、そのままでは
# どのグループがどのセッションのものか見分けられない。Herdr の中なら「ワークスペース名/タブ名」、
# 外なら MCP の作業ディレクトリ名にする。同じ名前が重なると拡張機能が「(2)」を付ける。
#
# 環境変数:
#   LENOVO_BROWSER_NEW_WINDOW=0  connect ページを既存ウィンドウのタブで開く
#   LENOVO_BROWSER_GROUP_NAME    タブグループの名前 (「Playwright · 」の後ろ) を直接指定する
#
# ⚠ connect URL にはトークンが入りうるので、URL はログに出さない。
# 背景と実測は machine/dev/lenovo-browser.md
set -u
STATE=$HOME/.local/state/lenovo-browser
LOG=$STATE/ext-shim.log
mkdir -p "$STATE"
log() { printf '%s [%s] %s\n' "$(date -Is)" "$$" "$*" >>"$LOG"; }
SSH=(ssh -o LogLevel=ERROR -o ConnectTimeout=10 -o BatchMode=yes)

# ログが膨らみ続けないよう 1 MiB を超えたら後ろ半分だけ残す
if [ -f "$LOG" ] && [ "$(stat -c %s "$LOG")" -gt 1048576 ]; then
	tail -c 524288 "$LOG" >"$LOG.tmp" && mv "$LOG.tmp" "$LOG"
fi

url="${!#}"
profile=""
for a in "$@"; do
	case $a in
		--profile-directory=*) profile=${a#*=} ;;
	esac
done
mcp_pid=$PPID

port=$(python3 -I -c '
import sys, urllib.parse as u
q = u.parse_qs(u.urlparse(sys.argv[1]).query)
r = q.get("mcpRelayUrl", [""])[0]
print(u.urlparse(r).port or "" if r else "")' "$url")
if [ -z "$port" ]; then
	log "connect URL から中継ポートを取れない"
	exit 1
fi

# タブグループの名前 (冒頭のコメントを参照)。shim は MCP の環境をそのまま受け継ぐので
# HERDR_* と、MCP の作業ディレクトリ (= Claude Code セッションの作業ディレクトリ) を使える。
herdr_label() {   # <tab|workspace> <id> → label (取れなければ空)
	timeout 3 "${HERDR_BIN_PATH:-herdr}" "$1" get "$2" 2>/dev/null | python3 -I -c '
import json, sys
r = json.load(sys.stdin).get("result", {})
print((r.get("tab") or r.get("workspace") or {}).get("label", ""))' 2>/dev/null
}
group_name() {
	if [ -n "${LENOVO_BROWSER_GROUP_NAME:-}" ]; then
		printf '%s' "$LENOVO_BROWSER_GROUP_NAME"
		return
	fi
	local ws="" tab=""
	if [ -n "${HERDR_TAB_ID:-}" ]; then
		tab=$(herdr_label tab "$HERDR_TAB_ID")
		[ -n "${HERDR_WORKSPACE_ID:-}" ] && ws=$(herdr_label workspace "$HERDR_WORKSPACE_ID")
	fi
	if [ -z "$ws" ]; then
		ws=$(readlink "/proc/$mcp_pid/cwd" 2>/dev/null || pwd)
		ws=${ws##*/}
	fi
	printf '%s' "$ws${tab:+/$tab}"
}
group=$(group_name)
# client={"name":...} の部分だけを書き換え、ほかのパラメータ (トークンを含む) は元の文字列のまま残す。
# ⚠ 書き換えた URL は PowerShell の Start-Process に渡すので、空白や引用符を生で残さない
#   (quote の safe="" ですべて %XX にする)。
renamed=$(python3 -I -c '
import json, re, sys, urllib.parse as u
url, name = sys.argv[1], sys.argv[2]
name = re.sub(r"\s+", " ", re.sub(r"[\x00-\x1f\x7f]", "", name)).strip()[:40]
if not name:
    sys.exit(1)
base, _, query = url.partition("?")
parts = query.split("&") if query else []
idx = next((i for i, p in enumerate(parts) if p.startswith("client=")), None)
client = {}
if idx is not None:
    try:
        client = json.loads(u.unquote_plus(parts[idx][len("client="):]))
    except ValueError:
        pass
if not isinstance(client, dict):
    client = {}
client["name"] = name
param = "client=" + u.quote(json.dumps(client, ensure_ascii=False, separators=(",", ":")), safe="")
if idx is None:
    parts.append(param)
else:
    parts[idx] = param
print(base + "?" + "&".join(parts))' "$url" "$group" 2>>"$LOG")
if [ -n "$renamed" ]; then
	url=$renamed
else
	group="(元の client 名のまま)"
fi
log "start mcp_pid=$mcp_pid port=$port profile=${profile:-<default>} group=$group"

# 1. 中継ポートを lenovo へ (develop の Node は localhost を 127.0.0.1 に bind する。
#    lenovo 側は localhost で ::1 と 127.0.0.1 の両方に listen する)
"${SSH[@]}" -N -o ExitOnForwardFailure=yes -o ServerAliveInterval=30 \
	-R "localhost:$port:localhost:$port" lenovo 2>>"$LOG" &
tun=$!
sleep 1.5
if ! kill -0 "$tun" 2>/dev/null; then
	log "トンネルが張れなかった"
	exit 1
fi

# 2. connect URL を Session 1 の Chrome で開く。lenovo-interactive (Session 1 の sshd) は
#    黙って止まることがあるので、通らなければ Session 0 からタスクを起こして 1 回だけやり直す
q() { printf "%s" "$1" | sed "s/'/''/g"; }
nw=""
[ "${LENOVO_BROWSER_NEW_WINDOW:-1}" = "0" ] || nw="'--new-window'"
ps="\$exe = 'C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe'
\$al = @($nw)
if ('$(q "$profile")' -ne '') { \$al += '--profile-directory=\"$(q "$profile")\"' }
\$al += '$(q "$url")'
\$sw = [Diagnostics.Stopwatch]::StartNew()
\$p = Start-Process -FilePath \$exe -ArgumentList \$al -PassThru
\$done = \$p.WaitForExit(15000)
'chrome.exe ms=' + \$sw.ElapsedMilliseconds + ' exited=' + \$done + \$(if (\$done) { ' code=' + \$p.ExitCode } else { '' })"
# ⚠ chrome.exe が終わるまで待ってから pwsh を終える。lenovo の sshd は、接続が終わるとそこから起動した
#   プロセスを殺す (50 ms 以上かかるものは生き残らなかった)。chrome.exe は起動中の Chrome に URL を渡して
#   終わるが、それが間に合わないと connect ページが開かず、Playwright MCP が「30 秒で繋がらない」で失敗する。
#   Chrome が起動していないときは chrome.exe 自身がブラウザになって終わらないので、15 秒で待つのをやめる
#   (その後、接続の終了とともに殺される。これは前からある制約)。
# 端末を付けない `ssh lenovo-interactive "<コマンド>"` は、利用者の画面にコンソールのウィンドウを開いて
# フォーカスを奪う。lenovo-interactive-run は端末付きで動かすので、ウィンドウが出ない。
# 出力には URL を含めない。chrome.exe にかかった時間の 1 行だけをログに残す
LIR=$(dirname "$(readlink -f "$0")")/../lenovo-interactive/lenovo-interactive-run
open_page() {
	local out
	out=$(timeout 30 "$LIR" "$ps" 2>>"$LOG") || return 1
	printf '%s\n' "$out" | grep -m1 '^chrome\.exe ms=' | while IFS= read -r line; do log "$line"; done
	return 0
}
if open_page; then
	log "connect ページを開いた"
else
	log "lenovo-interactive が通らない。LenovoInteractiveSshd を起こしてやり直す"
	restart=$(printf '%s' 'Start-ScheduledTask -TaskName LenovoInteractiveSshd' | iconv -f UTF-8 -t UTF-16LE | base64 -w0)
	timeout 30 "${SSH[@]}" lenovo "pwsh -NoProfile -EncodedCommand $restart" >/dev/null 2>>"$LOG"
	sleep 3
	if open_page; then
		log "connect ページを開いた (再試行)"
	else
		log "connect ページを開けなかった"
	fi
fi

# 3. MCP が生きている間だけトンネルを維持する
while kill -0 "$mcp_pid" 2>/dev/null && kill -0 "$tun" 2>/dev/null; do sleep 5; done
kill "$tun" 2>/dev/null
log "stop (mcp alive=$(kill -0 "$mcp_pid" 2>/dev/null && echo yes || echo no))"
