#!/usr/bin/env bash
# chatgpt-app-stop-scopes — ChatGPT デスクトップアプリが作った scope が残っていれば止める
#
# chatgpt-app.service の ExecStopPost= から呼ぶ。引数はアプリの --user-data-dir。
#
# Chromium は、セッションの D-Bus に届くと、本体と node のサービス (codex の app-server・
# exec-server を含む) を app-org.chromium.Chromium-<pid>.scope に移す。
# この scope は service の stop・restart では止まらない。service ではセッションの D-Bus に
# 届かないようにして scope を作らせないが、作られた場合に備えてここで止める。
#
# 止めるのは、/usr/lib/chatgpt/ のプログラムか、引数に --user-data-dir のパスを含む
# プロセスがいる scope だけにする。ほかの Chromium (shared-browser の Chrome など) は止めない。
set -euo pipefail

dir=${1:?usage: chatgpt-app-stop-scopes <user-data-dir>}

units=$(systemctl --user list-units --plain --no-legend 'app-org.chromium.Chromium-*.scope' | awk '{ print $1 }')
for unit in $units; do
	cg=$(systemctl --user show -p ControlGroup --value "$unit")
	procs=/sys/fs/cgroup$cg/cgroup.procs
	[ -r "$procs" ] || continue
	hit=0
	while read -r pid; do
		cmd=$(tr '\0' ' ' <"/proc/$pid/cmdline" 2>/dev/null || true)
		case "$cmd" in
			/usr/lib/chatgpt/* | *"$dir"*) hit=1; break ;;
		esac
	done <"$procs"
	if [ "$hit" = 1 ]; then
		systemctl --user stop "$unit"
		echo "$unit を止めた"
	fi
done
