#!/usr/bin/env bash
# shared-browser — 人間とエージェントで 1 つのブラウザを共有する (セッションごとに 1 インスタンス)
#
# 狙いは「人間の手が要るステップ (ログイン・2FA・CAPTCHA) を人間が突破し、
# 同じセッションのままエージェントに続けさせる」こと。
#
#   Xvfb :N ← google-chrome (headful, 常駐, プロファイル固定)
#     │                    └─ --remote-debugging-port=<cdp> (127.0.0.1 のみ)
#     │                          ▲ Playwright MCP が --cdp-endpoint でアタッチ
#     └─ x11vnc → websockify/noVNC → 127.0.0.1:<novnc> → lenovo へ ssh -R
#
# ブラウザは**ホスト**で動かし、X と VNC だけをコンテナに閉じ込める。
# こうするとダウンロード先・フォント・upload-dnd がホストのまま効く。
# (ホストに xvfb/x11vnc を入れるには sudo が要るがパスワード必須のため)
#
# **Claude Code のセッションごとに 1 インスタンス**を割り当てる。鍵は
# CLAUDE_CODE_SESSION_ID (stdio MCP のサブプロセスにも渡る)。`port` は
# **枠を予約するだけで起動しない**ので、ブラウザを使わないセッションに
# Chrome がぶら下がることはない。
#
# 🔴 並列で使うと孤児が増えるので `gc` が要る。レジストリに CLAUDE_PID を
#    控えてあり、その kill -0 で判定する (他プロセスの /proc/<pid>/environ は
#    読めないことを実測済み → dev/claude-code.md)。
#
# 常駐サービスにはしない。必要になったときに up し、終わったら down する。
# 背景と実測は machine/dev/shared-browser/README.md
set -euo pipefail

# 🔴 readlink -f を通すこと。~/.local/bin から symlink して呼ばれると
#    ${BASH_SOURCE[0]} は symlink 自身なので、素の dirname では ~/.local/bin を指し、
#    docker/ も ../lenovo-tunnel/ も見つからなくなる。
HERE=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)

GEOMETRY=${SB_GEOMETRY:-1600x900x24}
CLIENT_HOST=${SB_CLIENT_HOST:-lenovo}
TUNNEL=${SB_TUNNEL:-$HERE/../lenovo-tunnel/lenovo-tunnel}

# イメージのタグは docker/ の内容から決める。
# ⚠ ensure_image は「そのタグが無ければ建てる」だけなので、固定タグだと
#   Dockerfile を変えても永久に古いイメージが使われる (= 新しい機能が黙って欠ける)。
#   内容ハッシュにしておくと変更が自動で新タグになり、**稼働中のコンテナは
#   古いイメージを掴んだまま生き残る** (docker は参照されているイメージを消さない)。
IMAGE=${SB_IMAGE:-shared-browser-x:$(cat "$HERE/docker/Dockerfile" "$HERE/docker/entrypoint.sh" | sha256sum | cut -c1-12)}

# type (xdotool) の 1 文字あたりの間隔 [ms]。→ machine/dev/shared-browser/README.md
# 🔴 12ms では実測で 15 回中 2 回、文字が入れ替わる/重複する (しかも無警告)。
TYPE_DELAY=${SB_TYPE_DELAY:-100}

# スロット N (0..MAX-1) → display :(99+N) / noVNC 5063+N / CDP 9222+N
# ⚠ 5060/5061 はブラウザが SIP 用に拒否するので 5063 から始める
SLOT_MAX=${SB_SLOT_MAX:-20}
DISPLAY_BASE=99
NOVNC_BASE=5063
CDP_BASE=9222

STATE=$HOME/.local/state/shared-browser
REGISTRY=$STATE/registry           # key <TAB> slot <TAB> claude_pid <TAB> created
LOCK=$STATE/registry.lock
ENV_FILE=${SB_ENV_FILE:-$HOME/.config/shared-browser/env}

log() { printf '%s\n' "$*" >&2; }
die() { printf 'error: %s\n' "$*" >&2; exit 1; }

# ⚠ systemd --user の unit も対話 shell も docker グループを持たない
#   (user manager の起動が group 付与より前)。sg で補う。
#   さらに ⚠ sg の -c はログインシェル (zsh) で解釈されるので bash に渡し直す。
docker_() {
	local cmd
	printf -v cmd '%q ' docker "$@"
	sg docker -c "bash -c $(printf '%q' "$cmd")"
}

slot_display() { printf ':%s' "$((DISPLAY_BASE + $1))"; }
slot_novnc()   { printf '%s'  "$((NOVNC_BASE + $1))"; }
slot_cdp()     { printf '%s'  "$((CDP_BASE + $1))"; }
slot_profile() { printf '%s'  "$STATE/profile-$1"; }
slot_container(){ printf '%s' "shared-browser-x-$1"; }

load_password() {
	if [ -f "$ENV_FILE" ]; then
		# shellcheck disable=SC1090
		. "$ENV_FILE"
	fi
	if [ -z "${VNC_PASSWORD:-}" ]; then
		mkdir -p "$(dirname "$ENV_FILE")"
		# ⚠ `tr </dev/urandom | head -c N` は上流が SIGPIPE で死に pipefail に引っかかる。
		#   先に有限バイトを読んでから加工する。
		VNC_PASSWORD=$(head -c 24 /dev/urandom | base64 | LC_ALL=C tr -dc 'a-zA-Z0-9')
		VNC_PASSWORD=${VNC_PASSWORD:0:16}
		umask 077
		printf 'VNC_PASSWORD=%s\n' "$VNC_PASSWORD" >"$ENV_FILE"
		log "VNC パスワードを生成して $ENV_FILE に保存した"
	fi
}

default_key() {
	printf '%s' "${SB_KEY:-${CLAUDE_CODE_SESSION_ID:-default}}"
}

registry_get() {   # key → slot (無ければ空)
	[ -f "$REGISTRY" ] || return 0
	awk -F'\t' -v k="$1" '$1 == k { s = $2 } END { if (s != "") print s }' "$REGISTRY"
}

# key に slot を割り当てる (既にあればそれを返す)。起動はしない
registry_assign() {
	local key=$1 slot
	mkdir -p "$STATE"
	exec 9>"$LOCK"
	flock 9
	slot=$(registry_get "$key")
	if [ -z "$slot" ]; then
		local used i
		used=$( [ -f "$REGISTRY" ] && cut -f2 "$REGISTRY" || true )
		for ((i = 0; i < SLOT_MAX; i++)); do
			printf '%s\n' "$used" | grep -qx "$i" && continue
			# develop 側で既に埋まっているポートは避ける
			ss -ltnH "sport = :$(slot_novnc "$i")" 2>/dev/null | grep -q . && continue
			ss -ltnH "sport = :$(slot_cdp "$i")"   2>/dev/null | grep -q . && continue
			slot=$i; break
		done
		[ -n "$slot" ] || { flock -u 9; die "空きスロットが無い (SLOT_MAX=$SLOT_MAX)"; }
		printf '%s\t%s\t%s\t%s\n' "$key" "$slot" "${CLAUDE_PID:-}" "$(date -Is)" >>"$REGISTRY"
	fi
	flock -u 9
	printf '%s' "$slot"
}

registry_drop() {
	[ -f "$REGISTRY" ] || return 0
	exec 9>"$LOCK"; flock 9
	local tmp; tmp=$(mktemp)
	awk -F'\t' -v k="$1" '$1 != k' "$REGISTRY" >"$tmp" && mv "$tmp" "$REGISTRY"
	flock -u 9
}

container_running() {
	[ "$(docker_ inspect -f '{{.State.Running}}' "$(slot_container "$1")" 2>/dev/null || echo false)" = true ]
}

chrome_pid() {   # slot → pid (無ければ空)
	ps -eo pid,args | awk -v p="--user-data-dir=$(slot_profile "$1") " \
		'index($0, p) && $0 !~ /--type=/ { print $1; exit }'
}

ensure_image() {
	docker_ image inspect "$IMAGE" >/dev/null 2>&1 && return 0
	log "イメージ $IMAGE をビルドする"
	docker_ build -q -t "$IMAGE" "$HERE/docker" >/dev/null
}

cmd_port() {   # 枠を予約して CDP ポートだけ返す (起動しない)
	slot_cdp "$(registry_assign "$(default_key)")"
	printf '\n'
}

cmd_up() {
	local key; key=$(default_key)
	local slot; slot=$(registry_assign "$key")
	local disp novnc cdp profile
	disp=$(slot_display "$slot"); novnc=$(slot_novnc "$slot")
	cdp=$(slot_cdp "$slot");      profile=$(slot_profile "$slot")

	load_password
	ensure_image
	mkdir -p "$profile" /tmp/.X11-unix
	chmod 1777 /tmp/.X11-unix 2>/dev/null || true

	if container_running "$slot"; then
		log "X+VNC コンテナは起動済み (slot $slot, $disp)"
	else
		docker_ rm -f "$(slot_container "$slot")" >/dev/null 2>&1 || true
		# --ipc=host は X の MIT-SHM をホストの Chrome と共有させるため
		docker_ run -d --name "$(slot_container "$slot")" --ipc=host \
			-v /tmp/.X11-unix:/tmp/.X11-unix \
			-e "DISP=$disp" -e "GEOM=$GEOMETRY" -e "VNC_PASSWORD=$VNC_PASSWORD" \
			-p "127.0.0.1:$novnc:6080" "$IMAGE" >/dev/null
		local i
		for i in $(seq 1 40); do
			curl -fs -o /dev/null --max-time 2 "http://127.0.0.1:$novnc/vnc.html" 2>/dev/null && break
			sleep 1
		done
		log "X+VNC コンテナを起動した (slot $slot, $disp, noVNC 127.0.0.1:$novnc)"
	fi

	if [ -n "$(chrome_pid "$slot")" ]; then
		log "Chrome は起動済み (pid $(chrome_pid "$slot"))"
	else
		# setsid で親から切り離す。落とすときは profile でプロセスを引く
		DISPLAY=$disp setsid nohup google-chrome \
			--user-data-dir="$profile" \
			--remote-debugging-port="$cdp" \
			--no-first-run --no-default-browser-check \
			--window-position=0,0 \
			--window-size="${GEOMETRY%%x*},$(x=${GEOMETRY#*x}; echo "${x%%x*}")" \
			about:blank >>"$STATE/chrome-$slot.log" 2>&1 &
		local i
		for i in $(seq 1 40); do
			curl -fs -o /dev/null --max-time 2 "http://127.0.0.1:$cdp/json/version" 2>/dev/null && break
			sleep 1
		done
		log "Chrome を headful で起動した (CDP 127.0.0.1:$cdp)"
	fi

	LT_CLIENT_HOST=$CLIENT_HOST "$TUNNEL" up "$novnc" \
		|| log "warn: $CLIENT_HOST へのトンネルを張れなかった"
	log ""
	log "エージェント側: --cdp-endpoint http://127.0.0.1:$cdp"
	log "人間側  : $(viewer_url "$slot")"
}

effective_lport() {   # slot → lenovo 側で実際に割り当たっているポート
	LT_CLIENT_HOST=$CLIENT_HOST "$TUNNEL" list 2>/dev/null \
		| awk -v d=":$(slot_novnc "$1")" '$3 == d { sub(/^:/, "", $2); p = $2 } END { if (p) print p }'
}

viewer_url() {
	local lp; lp=$(effective_lport "$1")
	printf 'http://localhost:%s/vnc.html?autoconnect=true&resize=scale&reconnect=true&password=%s' \
		"${lp:-$(slot_novnc "$1")}" "${VNC_PASSWORD:-}"
}

cmd_open() {
	local key; key=$(default_key)
	local slot; slot=$(registry_get "$key")
	[ -n "$slot" ] || die "このセッションのインスタンスはまだ無い (先に up)"
	load_password
	LT_CLIENT_HOST=$CLIENT_HOST "$TUNNEL" open "$(slot_novnc "$slot")" \
		"/vnc.html?autoconnect=true&resize=scale&reconnect=true&password=$VNC_PASSWORD"
}

# --- 日本語入力 -------------------------------------------------------------
# 🔴 noVNC のクリップボード欄からは日本語を送れない (RFB 3.8 の ClientCutText は
#    latin-1 固定。noVNC 1.6 は UTF-8 拡張を持つが x11vnc/libvncserver が持たない
#    ので latin-1 へ落ち、日本語は全部 '?' になる)。実測は README を見ること。
#    そこで **X のクリップボードをホスト側から直接叩く**。X ソケットは共有されて
#    いるので、ホストの xsel がそのままコンテナ内の X に届く。

require_running_slot() {   # → slot (無ければ die)
	local key slot
	key=$(default_key)
	slot=$(registry_get "$key")
	[ -n "$slot" ] || die "このセッションのインスタンスはまだ無い (先に up)"
	container_running "$slot" || die "X+VNC コンテナが動いていない (先に up)"
	printf '%s' "$slot"
}

read_text() {   # 引数があればそれ、無ければ stdin
	if [ "$#" -gt 0 ]; then printf '%s' "$*"; else cat; fi
}

# クリップボードへ入れる。人間は noVNC 画面で入力欄をクリックして Ctrl+V。
cmd_paste() {
	local slot disp text got
	slot=$(require_running_slot)
	disp=$(slot_display "$slot")
	text=$(read_text "$@")
	[ -n "$text" ] || die "貼り付ける文字列が空 (引数か標準入力で渡す)"

	# ⚠ xsel は選択の所有者としてそのまま常駐する (X の仕様上そうなる)。
	#   display ごとに 1 つで、次に投入すると前の所有者は SelectionClear で終了する。
	printf '%s' "$text" | DISPLAY="$disp" xsel -b -i
	got=$(DISPLAY="$disp" xsel -b -o)
	[ "$got" = "$text" ] || die "クリップボードへの書き込みを確認できなかった ($disp)"

	log "クリップボード ($disp) に $(printf '%s' "$text" | LC_ALL=C.UTF-8 wc -m) 文字を入れた"
	log "→ noVNC 画面で入力欄をクリックし、Ctrl+V を押す"
}

# 貼り付けを禁止しているフォーム向けのフォールバック。実キーとして打ち込む。
# 🔴 xdotool は未割り当てのキーコードにキーシムを一時割り当てして打つので、
#    速いと X のキーマップ更新が追いつかず **無警告で文字が化ける**。
#    既定を 100ms にしてあるが、それでも打ち終わったら目視で確認すること。
cmd_type() {
	local slot disp container text
	slot=$(require_running_slot)
	disp=$(slot_display "$slot")
	container=$(slot_container "$slot")
	text=$(read_text "$@")
	[ -n "$text" ] || die "入力する文字列が空 (引数か標準入力で渡す)"

	docker_ exec "$container" sh -c 'command -v xdotool >/dev/null' \
		|| die "このスロットのコンテナに xdotool が無い (イメージが古い)。down してから up し直す"

	log "$disp の入力フォーカスへ $(printf '%s' "$text" | LC_ALL=C.UTF-8 wc -m) 文字を ${TYPE_DELAY}ms 間隔で打ち込む"
	log "⚠ 先に noVNC 画面で入力欄をクリックしてフォーカスを当てておくこと"
	# ⚠ LC_ALL を渡さないと xdotool が 'Invalid multi-byte sequence encountered' で落ちる
	docker_ exec -e "DISPLAY=$disp" -e LC_ALL=C.UTF-8 "$container" \
		xdotool type --clearmodifiers --delay "$TYPE_DELAY" -- "$text"
	log "打ち終わった。🔴 化けていないか画面で確認すること"
}

down_slot() {
	local slot=$1 pid
	pid=$(chrome_pid "$slot")
	[ -n "$pid" ] && kill "$pid" 2>/dev/null && log "  Chrome を停止 (slot $slot, pid $pid)"
	docker_ rm -f "$(slot_container "$slot")" >/dev/null 2>&1 \
		&& log "  コンテナを削除 (slot $slot)" || true
	LT_CLIENT_HOST=$CLIENT_HOST "$TUNNEL" down "$(slot_novnc "$slot")" >/dev/null 2>&1 || true
	return 0
}

cmd_down() {
	if [ "${1:-}" = "--all" ]; then
		[ -f "$REGISTRY" ] || { log "インスタンスは無い"; return 0; }
		local key slot rest
		while IFS=$'\t' read -r key slot rest; do
			log "$key (slot $slot)"
			down_slot "$slot"
			registry_drop "$key"
		done < <(cat "$REGISTRY")
		return 0
	fi
	local key; key=${1:-$(default_key)}
	local slot; slot=$(registry_get "$key")
	[ -n "$slot" ] || { log "このセッションのインスタンスは無い"; return 0; }
	log "$key (slot $slot)"
	down_slot "$slot"
	registry_drop "$key"
}

# 🔴 並列運用の生命線。死んだセッションのインスタンスを回収する
cmd_gc() {
	[ -f "$REGISTRY" ] || { log "インスタンスは無い"; return 0; }
	local key slot pid created n=0
	while IFS=$'\t' read -r key slot pid created; do
		[ -n "$key" ] || continue
		if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
			continue   # セッションが生きている
		fi
		if [ -z "$pid" ]; then
			log "skip $key (slot $slot): 手動作成なので回収しない"
			continue
		fi
		log "回収 $key (slot $slot, claude pid $pid は不在)"
		down_slot "$slot"
		registry_drop "$key"
		n=$((n + 1))
	done < <(cat "$REGISTRY")
	log "$n 件回収した"
}

cmd_list() {
	[ -f "$REGISTRY" ] && [ -s "$REGISTRY" ] || { log "インスタンスは無い"; return 0; }
	load_password
	printf '%-5s %-7s %-7s %-6s %-9s %-9s %s\n' SLOT DISPLAY noVNC CDP CHROME SESSION KEY
	local key slot pid created
	while IFS=$'\t' read -r key slot pid created; do
		[ -n "$key" ] || continue
		local c s
		c=$( [ -n "$(chrome_pid "$slot")" ] && echo running || echo '-' )
		if [ -z "$pid" ]; then s=manual
		elif kill -0 "$pid" 2>/dev/null; then s=alive
		else s=DEAD; fi
		printf '%-5s %-7s %-7s %-6s %-9s %-9s %s\n' \
			"$slot" "$(slot_display "$slot")" "$(slot_novnc "$slot")" "$(slot_cdp "$slot")" \
			"$c" "$s" "${key:0:20}"
	done < <(cat "$REGISTRY")
}

cmd_status() {
	local key; key=$(default_key)
	local slot; slot=$(registry_get "$key")
	[ -n "$slot" ] || { log "このセッション ($key) のインスタンスはまだ無い"; return 0; }
	load_password
	local cdp; cdp=$(slot_cdp "$slot")
	printf 'キー            : %s\n' "$key"
	printf 'スロット        : %s (%s)\n' "$slot" "$(slot_display "$slot")"
	printf 'X+VNC コンテナ  : %s\n' "$(container_running "$slot" && echo running || echo stopped)"
	printf 'Chrome (headful): %s\n' "$( [ -n "$(chrome_pid "$slot")" ] && echo "running (pid $(chrome_pid "$slot"))" || echo stopped)"
	local ver; ver=$(curl -fs --max-time 2 "http://127.0.0.1:$cdp/json/version" 2>/dev/null | sed -n 's/.*"Browser": "\(.*\)",/\1/p')
	printf 'CDP             : %s (127.0.0.1:%s)\n' "${ver:--}" "$cdp"
	local lp; lp=$(effective_lport "$slot")
	printf '%s へのトンネル : %s\n' "$CLIENT_HOST" "${lp:+localhost:}${lp:-none}"
	printf '閲覧 URL        : %s\n' "$(viewer_url "$slot")"
	if container_running "$slot"; then
		printf '開いているタブ  :\n'
		curl -fs --max-time 2 "http://127.0.0.1:$cdp/json/list" 2>/dev/null \
			| sed -n 's/^   "url": "\(.*\)",$/  - \1/p' | grep -v '^  - chrome-extension' || true
	fi
}

case "${1:-status}" in
	port)   cmd_port ;;
	up)     cmd_up ;;
	down)   shift; cmd_down "$@" ;;
	open)   cmd_open ;;
	gc)     cmd_gc ;;
	list)   cmd_list ;;
	status) cmd_status ;;
	paste)  shift; cmd_paste "$@" ;;
	type)   shift; cmd_type "$@" ;;
	*) die "usage: shared-browser {port|up|down [--all|<key>]|open|gc|list|status|paste [text]|type [text]}" ;;
esac
